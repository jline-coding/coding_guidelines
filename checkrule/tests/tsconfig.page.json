{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": "..",
    "paths": {"@/*": ["./*"]},
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "typecheck-stubs.d.ts",
    "../pages/index.tsx",
    "../lib/types.ts",
    "../lib/i18n.ts",
    "../lib/rules.ts",
    "../lib/folder-reader.ts"
  ]
}
